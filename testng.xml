<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Selenium Automation Suite" 
       parallel="methods" 
       thread-count="3">

    <!-- Smoke Tests -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

    <!-- Regression Tests -->
    <test name="Regression Tests">
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

</suite>
